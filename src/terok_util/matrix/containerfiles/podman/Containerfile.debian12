# Debian 12 (Bookworm) — podman 4.3.1, slirp4netns only
FROM docker.io/library/debian:12

{% include "_header.j2" %}

RUN apt-get update && apt-get install -y --no-install-recommends \
    podman slirp4netns nftables dnsmasq-base uidmap fuse-overlayfs crun \
    python3 \
    git curl ca-certificates dnsutils \
    $EXTRA_PACKAGES \
    && rm -rf /var/lib/apt/lists/*

# Debian 12 ships Python 3.11 — use uv to get 3.12+
{% include "_uv-python312.j2" %}

{% include "_rootless-podman-setup.j2" %}

WORKDIR /src
