{#- The slot body for the Arch family (manjaro): pacman, podman 6, pasta.
    pasta is the path that reproduces the AppArmor DNS breakage on Manjaro
    (terok-ai/terok#1246). -#}
{% include "_header.j2" %}

# Arch forbids partial upgrades, so the sync, upgrade, and install run in one
# transaction. bind provides dig. shadow provides newuidmap and newgidmap for
# the rootless nesting. base-devel builds any sdist without a wheel.
RUN pacman -Syu --noconfirm --needed \
        podman passt nftables dnsmasq fuse-overlayfs crun e2fsprogs \
        shadow util-linux findutils \
        python git curl ca-certificates bind base-devel bash \
        $EXTRA_PACKAGES \
    && rm -rf /var/cache/pacman/pkg/*

# The rolling python3 is newer than the pinned matrix interpreter, and runtime
# downloads are off. Provision the managed 3.12 at build time, like the void
# slot.
{% include "_uv-python312.j2" %}

{% include "_rootless-podman-setup.j2" %}

WORKDIR /src
