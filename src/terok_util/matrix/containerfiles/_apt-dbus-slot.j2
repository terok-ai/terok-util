{#- Whole dbus-flavor slot body for modern apt distros
    (debian13/ubuntu2404/ubuntu2604) - only FROM differs per slot. -#}
{% include "_header.j2" %}

RUN apt-get update && apt-get install -y --no-install-recommends \
    dbus \
    gcc python3-dev libdbus-1-dev libglib2.0-dev pkg-config meson \
    python3 python3-venv \
    git curl ca-certificates \
    $EXTRA_PACKAGES \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m testrunner
WORKDIR /src
