# Fedora 44 — dbus + dbusmock deps, looking forward to the next Fedora line
FROM registry.fedoraproject.org/fedora:44

{% include "_header.j2" %}

RUN dnf install -y \
    dbus-daemon \
    gcc python3-devel dbus-devel glib2-devel pkgconf meson \
    python3 python3-pip \
    git curl \
    $EXTRA_PACKAGES \
    && dnf clean all

RUN useradd -m testrunner
WORKDIR /src
