{#- Whole slot body for modern apt distros (debian13/ubuntu2404/ubuntu2604):
    same package set, same nesting setup - only FROM differs per slot. -#}
{% include "_header.j2" %}

RUN apt-get update && apt-get install -y --no-install-recommends \
    podman passt slirp4netns nftables dnsmasq-base uidmap fuse-overlayfs crun e2fsprogs \
    python3 python3-pip python3-venv \
    git curl ca-certificates dnsutils \
    $EXTRA_PACKAGES \
    && rm -rf /var/lib/apt/lists/*

{% include "_rootless-podman-setup.j2" %}

WORKDIR /src
