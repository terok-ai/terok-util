{#- uv binary + a managed Python 3.12 for distros whose system Python is too old. -#}
{% include "_uv-binary.j2" %}
# Install the managed interpreter to a world-readable shared dir - the
# default (/root/.local/...) would be invisible to the test user, who
# would silently re-download Python on every run.  ENV persists into
# the test session, so `uv venv --python 3.12` finds it there.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
RUN uv python install 3.12 && chmod -R a+rX /opt/uv
