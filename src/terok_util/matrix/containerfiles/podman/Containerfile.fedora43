# Fedora 43 — podman 5.8.x, pasta default, modern everything
FROM registry.fedoraproject.org/fedora:43

{% include "_header.j2" %}

RUN dnf install -y \
    podman passt nftables dnsmasq slirp4netns fuse-overlayfs crun \
    python3 python3-pip \
    git curl bind-utils \
    $EXTRA_PACKAGES \
    && dnf clean all

{% include "_rootless-podman-setup.j2" %}

WORKDIR /src
