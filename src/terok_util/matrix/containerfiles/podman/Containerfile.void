# Void Linux (runit, glibc) — a non-systemd glibc matrix slot.
#
# Purpose: prove the stack under test works on a non-systemd host that
# is *glibc* (unlike the musl Alpine slot) — the shape of the real
# non-systemd targets (Gentoo/OpenRC, SLURM nodes).  See terok-ai/terok#959, #1113.
#
# Deliberately non-systemd (runit).  The matrix runner preflight asserts
# systemd is absent for this slot.
#
# Dep set mirrors the Alpine slot: the podman stack + a build toolchain
# for any sdist without a wheel.  Repo-specific packages (dbus, ssh,
# build headers) arrive via the EXTRA_PACKAGES build arg.
#
# NOTE: Void package names are best-effort and may need adjustment on the
# first matrix run (Void uses xbps; -devel suffixes; base-devel for the
# toolchain).
FROM ghcr.io/void-linux/void-glibc:latest

{% include "_header.j2" %}

# Sync + self-update xbps first (rolling release), then install deps.  The
# musl toolchain equivalents from the Alpine slot are glibc here; build
# tooling (base-devel + libffi-devel) covers any sdist (e.g. cffi) without
# a wheel.  bind-utils provides dig; shadow provides newuidmap/newgidmap.
RUN xbps-install -Suy xbps \
    && xbps-install -Sy \
        podman slirp4netns nftables dnsmasq fuse-overlayfs crun \
        shadow util-linux findutils \
        python3 python3-devel \
        git curl ca-certificates bind-utils bash \
        base-devel libffi-devel \
        $EXTRA_PACKAGES

# Rolling python3 outruns the matrix interpreter, and the runtime
# download that used to paper over it is pinned off — provision the
# managed 3.12 at build time like the other too-old/too-new distros.
{% include "_uv-python312.j2" %}

{% set user_shell = ' -s /bin/bash' %}
{% set rootless_network_cmd = 'slirp4netns' %}
{% include "_rootless-podman-setup.j2" %}

WORKDIR /src
