# Fedora 44 — podman 5.x line, pasta default, looking forward
FROM registry.fedoraproject.org/fedora:44

{% include "_header.j2" %}

RUN dnf install -y \
    podman passt nftables dnsmasq slirp4netns fuse-overlayfs crun \
    python3 python3-pip \
    git curl bind-utils \
    $EXTRA_PACKAGES \
    && dnf clean all

{% include "_rootless-podman-setup.j2" %}

WORKDIR /src
