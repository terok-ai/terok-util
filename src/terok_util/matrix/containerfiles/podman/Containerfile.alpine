# Alpine (OpenRC, musl) — the non-systemd matrix slot.
#
# Purpose: prove the stack under test works on a host with NO systemd
# at all — the floor case for OpenRC servers (Gentoo/Alpine), runit/s6
# images, and SLURM interactive jobs.  See terok-ai/terok#959 and #1113.
#
# Deliberately does NOT install systemd (the debian/fedora slots do).
# The matrix runner preflight asserts systemd is absent here, so the
# slot can never silently regress into testing a systemd host.
#
# Alpine ships Python 3.12 natively, so no uv-managed interpreter is
# needed; uv is still used for a fast, ensurepip-independent venv
# (Alpine's stdlib venv ships no bundled pip).  The uv binary in the
# official image is a static musl build and runs as-is on Alpine.
FROM docker.io/library/alpine:3.21

{% include "_header.j2" %}

# musl toolchain (build-base + *-dev) lets poetry build any dependency
# that lacks a musllinux wheel; bind-tools provides dig for DNS
# probes; bash is required by the harness (busybox sh is not bash).
RUN apk add --no-cache \
    podman slirp4netns nftables dnsmasq fuse-overlayfs crun \
    shadow shadow-uidmap \
    python3 \
    git curl ca-certificates bind-tools bash \
    build-base python3-dev libffi-dev \
    $EXTRA_PACKAGES

{% include "_uv-binary.j2" %}

{% set user_shell = ' -s /bin/bash' %}
{% set rootless_network_cmd = 'slirp4netns' %}
{% include "_rootless-podman-setup.j2" %}

WORKDIR /src
